{
  "name": "@servoy/kiro-usage-panel",
  "version": "1.4.0",
  "private": true,
  "license": "MIT",
  "description": "OpenChamber panel showing AWS Kiro credit usage for the opencode-kiro-auth plugin",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "kiro-usage",
        "name": "Kiro Usage",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "page": true,
      "capabilities": [
        "sessions"
      ],
      "filesystem": [
        "~/.config/opencode/kiro-usage.json",
        "~/AppData/Roaming/opencode/kiro-usage.json",
        "~/.servoy/opencode/kiro-usage.json"
      ]
    }
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
